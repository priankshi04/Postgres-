Table users{
  id int [pk, increment]
  created_at timestamp [default:'CURRENT_TIMESTAMP']
  username varchar(30) [not null, unique]
}

Table posts{
  id integer [pk, increment]
  created_at timestamp [default:'CURRENT_TIMESTAMP']
  user_id int [not null,ref:>users.id]
  contents varchar (1000) [not null]
}

Table comments{
  id int [pk, increment]
  created_at timestamp [default:'CURRENT_TIMESTAMP']
  updated_at timestamp [default:'CURRENT_TIMESTAMP']
  contents varchar (1000) [not null]
  user_id int [not null,ref:>users.id]
  post_id int [not null,ref:>posts.id]
  parent_comment_id int
  is_edited boolean [not null, default:false]
  is_deleted boolean [not null, default:false]

  indexes {
    (id, post_id) [unique]
    user_id [name:'idx_comments_user_id']
    post_id [name:'idx_comments_posts_id']
    parent_comment_id [name:'idx_comments_parent_comment_id']
    (post_id, created_at) [name:'idx_comments_post_created_at']
  }

}
Ref: comments.(parent_comment_id, post_id) > comments.(id,post_id)
